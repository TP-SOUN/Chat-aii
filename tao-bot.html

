<div class="section" style="background: white; border-radius: 15px; padding: 15px; margin-bottom: 15px; border: 1px solid #f1f1f1;">
    <label class="label">Giọng nói nhân vật<span>*</span></label>
    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
        <div class="voice-item" onclick="previewVoice('voice1')" style="flex: 1; min-width: 100px; padding: 10px; border: 1px solid #ddd; border-radius: 12px; text-align: center; cursor: pointer;">
            <span style="display: block; font-size: 20px;">🎙️</span>
            <small>Trầm ấm</small>
        </div>
        <div class="voice-item" onclick="previewVoice('voice2')" style="flex: 1; min-width: 100px; padding: 10px; border: 1px solid #ddd; border-radius: 12px; text-align: center; cursor: pointer;">
            <span style="display: block; font-size: 20px;">🎙️</span>
            <small>Dễ thương</small>
        </div>
        <div class="voice-item" onclick="previewVoice('voice3')" style="flex: 1; min-width: 100px; padding: 10px; border: 1px solid #ddd; border-radius: 12px; text-align: center; cursor: pointer;">
            <span style="display: block; font-size: 20px;">🎙️</span>
            <small>Lạnh lùng</small>
        </div>
    </div>
    <p style="font-size: 11px; color: #999; margin-top: 10px;">Bấm vào để nghe thử giọng mẫu trước khi chọn nhen ní!</p>
</div>

<style>
    /* Style cho cái mục giọng nói */
    .voice-item.active {
        border-color: #f06292 !important;
        background: #fff0f3 !important;
        color: #f06292 !important;
        font-weight: bold;
    }
</style>

<script>
    // Hàm để nghe thử giọng
    function previewVoice(voiceId) {
        // Xóa active cũ
        document.querySelectorAll('.voice-item').forEach(v => v.classList.remove('active'));
        // Thêm active cho cái vừa chọn
        event.currentTarget.classList.add('active');
        
        // Giả lập phát âm thanh (Lát ní đưa link mp3 vào đây)
        console.log("Đang phát thử giọng: " + voiceId);
        // Ví dụ: let audio = new Audio('link_am_thanh.mp3'); audio.play();
    }
</script>

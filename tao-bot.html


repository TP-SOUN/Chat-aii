<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Tạo Bot Pro - TP C-AI</title>
    <style>
        :root { --main: #6c5ce7; --bg: #fdfdfd; --pink: #fd79a8; }
        body { font-family: 'Segoe UI', sans-serif; margin: 0; background: var(--bg); color: #333; padding-bottom: 100px; }
        
        .header { background: #fff; padding: 15px; display: flex; align-items: center; border-bottom: 1px solid #eee; position: sticky; top: 0; z-index: 100; }
        .back-btn { font-size: 24px; color: var(--main); cursor: pointer; margin-right: 15px; }
        .h-title { flex: 1; font-weight: bold; font-size: 18px; }

        .container { padding: 15px; }
        .input-group { background: #fff; border-radius: 15px; padding: 18px; margin-bottom: 15px; border: 1px solid #f1f1f1; box-shadow: 0 2px 8px rgba(0,0,0,0.02); }
        .label { font-weight: bold; font-size: 14px; margin-bottom: 10px; display: block; color: #444; }
        .label span { color: var(--pink); margin-left: 3px; }
        
        input, textarea, select {
            width: 100%; border: none; background: #f8f9ff; border-radius: 12px; padding: 14px; box-sizing: border-box; outline: none; font-size: 14px; border: 1px solid transparent;
        }
        textarea { resize: none; line-height: 1.5; }
        input:focus, textarea:focus { border-color: var(--main); background: #fff; }

        .hint { font-size: 11px; color: #999; margin-top: 6px; display: block; }

        /* Voice List */
        .voice-list { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 10px; }
        .v-item { flex: 0 0 100px; padding: 12px; border: 1.5px solid #eee; border-radius: 15px; text-align: center; cursor: pointer; }
        .v-item.active { border-color: var(--main); background: #f0edff; color: var(--main); }

        /* Avatar */
        .avt-box { width: 90px; height: 90px; background: #f8f9ff; border-radius: 20px; display: flex; align-items: center; justify-content: center; border: 2px dashed #ddd; cursor: pointer; overflow: hidden; }
        .avt-box img { width: 100%; height: 100%; object-fit: cover; }

        /* Footer */
        .footer { position: fixed; bottom: 0; width: 100%; background: #fff; padding: 15px; border-top: 1px solid #eee; box-sizing: border-box; }
        .btn-create { width: 100%; padding: 16px; background: var(--main); color: white; border: none; border-radius: 16px; font-weight: bold; font-size: 16px; box-shadow: 0 4px 15px rgba(108, 92, 231, 0.3); }
    </style>
</head>
<body>

    <div class="header">
        <div class="back-btn" onclick="history.back()">❮</div>
        <div class="h-title">Tạo Nhân Vật</div>
    </div>

    <div class="container">
        <div class="input-group">
            <label class="label">Ảnh đại diện<span>*</span></label>
            <div class="avt-box" onclick="document.getElementById('f').click()">
                <img id="p" style="display:none"> <span id="s">+</span>
            </div>
            <input type="file" id="f" hidden onchange="showI(this)">
        </div>

        <div class="input-group">
            <label class="label">Tên nhân vật<span>*</span></label>
            <input type="text" placeholder="Tên của Bot...">
        </div>

        <div class="input-group">
            <label class="label">Giọng nói nhân vật<span>*</span></label>
            <div class="voice-list">
                <div class="v-item active" onclick="setV(this)">👨 Nam Trầm</div>
                <div class="v-item" onclick="setV(this)">👩 Nữ Ngọt</div>
                <div class="v-item" onclick="setV(this)">🦊 Anime</div>
                <div class="v-item" onclick="setV(this)">❄️ Lạnh Lùng</div>
            </div>
        </div>

        <div class="input-group">
            <label class="label">Lời chào đầu tiên<span>*</span></label>
            <textarea rows="3" placeholder="Ví dụ: 'Chào cưng, hôm nay anh đến hơi muộn nhỉ?'"></textarea>
            <span class="hint">Câu nói đầu tiên khi mở khung chat.</span>
        </div>

        <div class="input-group">
            <label class="label">Bối cảnh cuộc trò chuyện (Scenario)<span>*</span></label>
            <textarea rows="4" placeholder="Ví dụ: Hai người đang ngồi trong quán cà phê vào một buổi chiều mưa, mối quan hệ là bạn thân..."></textarea>
            <span class="hint">Mô tả tình huống hiện tại để Bot nhập vai.</span>
        </div>

        <div class="input-group">
            <label class="label">Lịch sử nhân vật (Character Lore)<span>*</span></label>
            <textarea rows="6" placeholder="Ví dụ: Anh ấy là một thiếu gia nhà giàu nhưng sống nội tâm, thích mèo, ghét người lừa dối..."></textarea>
            <span class="hint">Tất cả thông tin về cuộc đời, sở thích, thói quen của Bot.</span>
        </div>

        <div class="input-group">
            <label class="label">Mẫu câu đối thoại (Example Dialogue)</label>
            <textarea rows="5" placeholder="<user>: Chào anh!<bot>: Cuối cùng thì em cũng chịu xuất hiện rồi à?"></textarea>
            <span class="hint">Dạy Bot cách nói chuyện đặc trưng của nó.</span>
        </div>

        <div class="input-group">
            <label class="label">Độ sáng tạo (Nhiệt độ)</label>
            <input type="range" min="0" max="1" step="0.1" value="0.7">
        </div>
    </div>

    <div class="footer">
        <button class="btn-create" onclick="alert('Đã đúc thành công!'); history.back()">XÁC NHẬN TẠO</button>
    </div>

    <script>
        function showI(i) {
            if (i.files && i.files[0]) {
                var r = new FileReader();
                r.onload = function(e) {
                    document.getElementById('p').src = e.target.result;
                    document.getElementById('p').style.display = 'block';
                    document.getElementById('s').style.display = 'none';
                }
                r.readAsDataURL(i.files[0]);
            }
        }
        function setV(el) {
            document.querySelectorAll('.v-item').forEach(v => v.classList.remove('active'));
            el.classList.add('active');
        }
    </script>
</body>
</html>
